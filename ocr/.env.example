BACKEND_BASE_URL=https://women-health-backend-team-bread.nadamkrishna.workers.dev/api
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.0-flash

# Admin query tool — off by default. Only turn on if you actually need the
# escape-hatch tool, and keep the token out of any client/frontend code.
ADMIN_TOOL_ENABLED=false
ADMIN_TOKEN=

# easyocr (default, better accuracy) or tesseract (lighter)
OCR_ENGINE=easyocr
