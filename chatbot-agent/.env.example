# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Backend API base URL (defaults to the team backend if unset)
BACKEND_BASE_URL=https://women-health-backend-team-bread.nadamkrishna.workers.dev/api

# Optional: override the default chat model
LLM_MODEL=gemini-3.5-flash-lite

# Optional: per-user rate limit on POST /agent/chat/{user_id}
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_SECONDS=60
