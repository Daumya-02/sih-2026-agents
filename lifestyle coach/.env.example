# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Backend API base URL (defaults to the team backend if unset)
BACKEND_BASE_URL=https://women-health-backend-team-bread.nadamkrishna.workers.dev/api

# Admin bearer token for controlled SQL UPDATE calls (server-side only)
ADMIN_TOKEN=your_admin_token_here

# Optional: override the default chat model
LLM_MODEL=gemini-3.5-flash-lite

# Optional: per-user rate limit on GET /api/insights/{user_id}
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_SECONDS=60
